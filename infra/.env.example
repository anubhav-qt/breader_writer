# The writer on the laptop (compose.yml). Copy to infra/.env, or let `npm run live:env` write it:
# it fills in everything marked "from breader" out of breader's own infra/.env. Never commit it.

# The server image CI publishes on every push to dev.
IMAGE=ghcr.io/anubhav-qt/breader-writer:latest
NODE_ENV=production
LOG_LEVEL=info

# The app's address: breader's, since the app is at breader.site/writer.
ALLOWED_ORIGINS=https://breader.site
# Who can write, once their email is confirmed, and who signs the AI accounts in and out (each
# must be in WRITER_EMAILS too). Comma separated.
WRITER_EMAILS=
OWNER_EMAILS=

# Breader's database (Supabase), where the writer schema lives beside breader's tables. From breader:
# DATABASE_URL is its transaction pooler (PRIMARY_URL), SESSION_DATABASE_URL its session pooler
# (PRIMARY_SESSION_URL), for the migrations and the backup.
DATABASE_URL=
DATABASE_SSL=require
SESSION_DATABASE_URL=

# Breader's login cookie is signed with its SESSION_SECRET. From breader.
SESSION_SECRET=
COOKIE_SECURE=true

# The AI accounts' proxy that breader's worker runs. Its keys are made from breader's ADMIN_TOKEN,
# as breader makes them (server/src/lib/cliproxy.ts there). From breader.
CLIPROXY_URL=http://worker:8327
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_KEY=

# The nightly backup: breader's backup key and R2 backup bucket, under writer/. From breader.
BACKUP_RECIPIENT=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BACKUP_BUCKET=
