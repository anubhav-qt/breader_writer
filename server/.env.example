# The writer's server. Copy to .env (npm run dev:env fills it in for local development).

# The writer's own tables: locally, the Postgres from `npm run db`.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/writer
DATABASE_SSL=off

# Breader's logins, read only. Unset in production (the same database as DATABASE_URL).
# Locally: prod breader's Supabase, so a real breader login works here.
BREADER_DATABASE_URL=
BREADER_DATABASE_SSL=require

# Breader's own values: its login cookie is signed with SESSION_SECRET.
SESSION_SECRET=
COOKIE_SECURE=true

ALLOWED_ORIGINS=https://local.breader.site:5174
# Who can write, once their email is confirmed.
WRITER_EMAILS=
NODE_ENV=development
LOG_LEVEL=info
PORT=8790
