{#-
  A scene: where and when, who is in it, what its folded turns said, and its turns not folded
  yet, word for word. An author note is the owner speaking as the author: the story follows it
  and never says it.
-#}
{% macro turns(list, protagonist) %}
{% for turn in list %}
<turn number="{{ turn.number }}">
{% if turn.voice == 'author' %}
<author_note>{{ turn.input }}</author_note>
{% else %}
<move by="{{ protagonist }}">{{ turn.input }}</move>
{% endif %}
{% if turn.reply %}
<reply>{{ turn.reply }}</reply>
{% endif %}
</turn>
{% endfor %}
{% endmacro %}

{% macro scene(s, protagonist) %}
<scene number="{{ s.number }}">
{% if s.place %}
Where: {{ s.place }}
{% endif %}
{% if s.time %}
When: {{ s.time }}
{% endif %}
{% if s.present.length %}
Present: {{ s.present | join(', ') }}
{% endif %}
{% if s.summary %}
<summary>
{{ s.summary }}
</summary>
{% endif %}
{{ turns(s.turns, protagonist) -}}
</scene>
{% endmacro %}
