{#-
  Turns, word for word: the owner's move or author note, and the reply. An author note is the
  owner speaking as the author: the story follows it and never says it.
-#}
{% macro turns(list, protagonist) %}
{% for turn in list %}
<turn number="{{ turn.number }}">
{% if turn.voice == 'author' %}
<author_note>{{ turn.input }}</author_note>
{% else %}
<move by="{{ protagonist }}">{{ turn.input }}</move>
{% endif %}
{% if turn.reply %}
<reply>{{ turn.reply }}</reply>
{% endif %}
</turn>
{% endfor %}
{% endmacro %}
