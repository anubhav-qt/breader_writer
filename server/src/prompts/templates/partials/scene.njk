{#-
  Turns, word for word: the owner's move, an author note, a scene's opening or an actor's answer,
  and the reply. An author note is the owner speaking as the author: the story follows it and never
  says it.
-#}
{% macro turns(list) %}
{% for turn in list %}
<turn number="{{ turn.number }}">
{% if turn.voice == 'author' %}
<author_note>{{ turn.input }}</author_note>
{% elif turn.voice == 'opening' %}
{% if turn.input %}
<scene_opens>The owner's pick of how the story opens: {{ turn.input }}</scene_opens>
{% else %}
<scene_opens/>
{% endif %}
{% elif turn.voice == 'actor' %}
<actor name="{{ turn.played }}">{{ turn.input }}</actor>
{% else %}
<move by="{{ turn.played }}">{{ turn.input }}</move>
{% endif %}
{% if turn.reply %}
<reply>{{ turn.reply }}</reply>
{% endif %}
</turn>
{% endfor %}
{% endmacro %}
