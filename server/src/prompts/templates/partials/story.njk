{#-
  The story as it stands, rebuilt from the database for every call (story/view.ts lays it out).
  It's the long context, so it comes first; each prompt puts its task after it. Takes `story`,
  a StoryView. The scene being played isn't here: each prompt places it where it needs it.
-#}
{% from "partials/scene.njk" import scene %}
{% macro when(number) %}{% if number === null %}Before the story{% else %}Scene {{ number }}{% endif %}{% endmacro %}
<book>
Title: {{ story.title }}
Length: {{ story.length }}
Style: {{ story.style }}
Point of view: {{ story.pov }}
How dark: {{ story.darkness }}
Where it stands: {{ story.pacing }}
</book>
{% set world = story.world %}
{% if world.genre or world.tone or world.setting or world.rules or world.notes %}

<world>
{% if world.genre %}
Genre: {{ world.genre }}
{% endif %}
{% if world.tone %}
Tone: {{ world.tone }}
{% endif %}
{% if world.setting %}
Setting: {{ world.setting }}
{% endif %}
{% if world.rules %}
Rules: {{ world.rules }}
{% endif %}
{% if world.notes %}
Notes: {{ world.notes }}
{% endif %}
</world>
{% endif %}

<cast>
{% for c in story.cast %}
<character name="{{ c.name }}"{% if c.protagonist %} played_by="the owner"{% endif %}>
{% if c.who %}
Who: {{ c.who }}
{% endif %}
{% if c.personality %}
Personality: {{ c.personality }}
{% endif %}
{% if c.past %}
Past: {{ c.past }}
{% endif %}
{% if c.notes %}
Notes: {{ c.notes }}
{% endif %}
{% if c.growth.length %}
Grown over the story:
{% for g in c.growth %}
- {{ when(g.scene) }}: {{ g.text }}
{% endfor %}
{% endif %}
</character>
{% endfor %}
</cast>
{% if story.close.length or story.distant.length %}

<relationships>
{% for r in story.close %}
<relationship between="{{ r.a.name }} and {{ r.b.name }}">
{% if r.bond %}
Bond: {{ r.bond }}
{% endif %}
{% if r.a.sees %}
How {{ r.a.name }} sees {{ r.b.name }}: {{ r.a.sees }}
{% endif %}
{% if r.a.hides %}
What {{ r.a.name }} hides from {{ r.b.name }}: {{ r.a.hides }}
{% endif %}
{% if r.b.sees %}
How {{ r.b.name }} sees {{ r.a.name }}: {{ r.b.sees }}
{% endif %}
{% if r.b.hides %}
What {{ r.b.name }} hides from {{ r.a.name }}: {{ r.b.hides }}
{% endif %}
{% if r.history.length %}
How they got here:
{% for h in r.history %}
- {{ when(h.scene) }}: {{ h.text }}
{% endfor %}
{% endif %}
</relationship>
{% endfor %}
{% if story.distant.length %}
Between people not in the scene, in short:
{% for r in story.distant %}
{% if r.bond %}
- {{ r.a }} and {{ r.b }}: {{ r.bond }}
{% else %}
- {{ r.a }} and {{ r.b }}: tied, with nothing written yet
{% endif %}
{% endfor %}
{% endif %}
</relationships>
{% endif %}
{% if story.arc %}

<arc>
{{ story.arc }}
</arc>
{% endif %}
{% if story.threads.length %}

<open_threads>
{% for t in story.threads %}
{% if t.opened === null %}
- Thread {{ t.id }}, from before the story: {{ t.text }}
{% else %}
- Thread {{ t.id }}, opened in scene {{ t.opened }}: {{ t.text }}
{% endif %}
{% endfor %}
</open_threads>
{% endif %}
{% if story.facts.length %}

<facts>
{% for f in story.facts %}
- {{ when(f.scene) }}: {{ f.text }}
{% endfor %}
</facts>
{% endif %}
{% if story.timeline.length %}

<timeline>
{% for e in story.timeline %}
- {{ e.when }} ({{ when(e.scene) }}): {{ e.what }}
{% endfor %}
</timeline>
{% endif %}
{% if story.earlier.length %}

<earlier_scenes>
{% for s in story.earlier %}
{{ scene(s, story.protagonist) -}}
{% endfor %}
</earlier_scenes>
{% endif %}
